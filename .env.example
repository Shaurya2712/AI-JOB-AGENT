# Job Agent runs without external credentials; optional AI matching is disabled by default.
JOB_AGENT_ENVIRONMENT=local
JOB_AGENT_DATABASE_URL=sqlite:///./data/job_agent.db
JOB_AGENT_LOG_LEVEL=INFO
JOB_AGENT_RESUME_STORAGE_PATH=./data/resumes
JOB_AGENT_RESUME_MAX_BYTES=5242880
JOB_AGENT_COMPANY_SEED_PATH=./data/seeds/companies.json
JOB_AGENT_SEARCH_PROVIDER=brave
JOB_AGENT_BRAVE_SEARCH_API_KEY=
JOB_AGENT_SEARCH_COUNTRY=IN
JOB_AGENT_SEARCH_LANGUAGE=en
JOB_AGENT_SEARCH_RESULTS_PER_QUERY=10
JOB_AGENT_SEARCH_MAX_QUERIES_PER_RUN=30
JOB_AGENT_PORTAL_SEARCH_MAX_QUERIES_PER_RUN=18
JOB_AGENT_SEARCH_CONCURRENCY=3
JOB_AGENT_SEARCH_TIMEOUT_SECONDS=10
JOB_AGENT_JOB_SOURCE_TIMEOUT_SECONDS=15
JOB_AGENT_JOB_SOURCE_CONCURRENCY=3
JOB_AGENT_JOB_SOURCE_MAX_RESPONSE_BYTES=8388608
JOB_AGENT_JOB_LIFECYCLE_CLOSE_AFTER_MISSING_SCANS=3
JOB_AGENT_DAILY_ACTION_TARGET=10
JOB_AGENT_SCAN_INTERVAL_HOURS=4
JOB_AGENT_TELEGRAM_BOT_TOKEN=
JOB_AGENT_TELEGRAM_MATCH_THRESHOLD=85
JOB_AGENT_TELEGRAM_TIMEOUT_SECONDS=10
JOB_AGENT_AI_PROVIDER=disabled
JOB_AGENT_AI_MODEL=
JOB_AGENT_OPENAI_API_KEY=
JOB_AGENT_ANTHROPIC_API_KEY=
JOB_AGENT_GEMINI_API_KEY=
JOB_AGENT_AI_TIMEOUT_SECONDS=45
JOB_AGENT_AI_CONCURRENCY=2
